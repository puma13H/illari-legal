# Solo para almacenamiento NUEVO. No cambia contraseñas de volúmenes existentes.
# Copiar a credenciales/runtime.env (ignorado por Git) y completar todos los secretos.
COMPOSE_PROJECT_NAME=illari-s12
ILLARI_CONTAINER_PREFIX=illari
ILLARI_ENVIRONMENT=development
POSTGRES_PASSWORD=
CLIENTES_DB_PASSWORD=
SERVICIOS_DB_PASSWORD=
ORDENES_DB_PASSWORD=
PAGOS_DB_PASSWORD=
LEGACY_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Contraseña para el primer administrador del portal en una base nueva.
ILLARI_ADMIN_INICIAL_PASSWORD=
ILLARI_REGISTROS_CLIENT_SECRET=
ILLARI_GUIA_SERVICIO_ID=15
# Usar las credenciales de la misma cuenta de Mercado Pago Perú.
MERCADOPAGO_YAPE_ENABLED=false
MERCADOPAGO_YAPE_MIN_CENTIMOS=124
MERCADOPAGO_YAPE_MODE=test
MERCADOPAGO_YAPE_PUBLIC_KEY=
MERCADOPAGO_YAPE_ACCESS_TOKEN=
MERCADOPAGO_YAPE_SELLER_ID=0
# Titular y celular peruano de la cuenta que recibirá cada transferencia.
PAGOS_PLIN_TITULAR=
PAGOS_PLIN_CELULAR=
PAGOS_BIPAY_TITULAR=
PAGOS_BIPAY_CELULAR=
GATEWAY_PORT=18080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=13100
BLACKBOX_PORT=19115
ALLOY_PORT=12345
CHECKOUT_PORT=4200
KEYCLOAK_PORT=18180
KEYCLOAK_PUBLIC_URL=http://localhost:18180
FRONTEND_PUBLIC_URL=http://localhost:4200
