{
  "uid": "illari-s12-overview",
  "title": "ILLARI LEGAL - Observabilidad",
  "tags": [
    "illari",
    "s12",
    "laboratorio"
  ],
  "schemaVersion": 40,
  "version": 2,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "traceId",
        "type": "textbox",
        "label": "Trace ID tecnico",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 23,
      "title": "Keycloak · Disponibilidad",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"illari-readiness\",instance=\"http://keycloak:9000/health/ready\"}",
          "legendFormat": "Keycloak",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Blackbox consulta la ruta interna /health/ready de Keycloak, que incluye una comprobación de PostgreSQL."
    },
    {
      "id": 24,
      "title": "Keycloak · Memoria de la JVM",
      "description": "Memoria heap que utiliza el proceso de Keycloak.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"keycloak\",area=\"heap\"})",
          "legendFormat": "Heap en uso"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 25,
      "title": "Keycloak · Conexiones a PostgreSQL",
      "description": "Conexiones activas y disponibles del pool de Keycloak.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(agroal_active_count{job=\"keycloak\"})",
          "legendFormat": "En uso"
        },
        {
          "refId": "B",
          "expr": "sum(agroal_available_count{job=\"keycloak\"})",
          "legendFormat": "Disponibles"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 1,
      "title": "Disponibilidad de las métricas por servicio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"legal-gateway|cliente-ms|servicio-legal-ms|orden-legal-ms|pago-ms|backend-legacy|keycloak\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
