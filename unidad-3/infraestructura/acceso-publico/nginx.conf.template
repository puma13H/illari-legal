server_names_hash_bucket_size 128;

server {
    listen 8080 default_server;
    server_name _;
    location = /salud { return 200 'OK'; }
    location / { return 404; }
}

server {
    listen 8080;
    server_name ${ILLARI_PUBLIC_HOST};
    client_max_body_size 11m;
    resolver 127.0.0.11 valid=10s ipv6=off;

    location ~ ^/realms/illari-legal/ {
        set $identity keycloak:8080;
        proxy_pass http://$identity;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        add_header Cache-Control "no-store" always;
    }

    location /resources/ {
        set $identity keycloak:8080;
        proxy_pass http://$identity;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
    }

    location ~ ^/(admin|realms|metrics|actuator)(/|$) { return 404; }

    location / {
        set $checkout checkout-web:8080;
        proxy_pass http://$checkout;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 45s;
    }
}
