server {
    listen 8080;
    server_name _;
    client_max_body_size 11m;
    root /usr/share/nginx/html;
    resolver 127.0.0.11 valid=10s ipv6=off;

    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self' https://sdk.mercadopago.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' ${CHECKOUT_KEYCLOAK_ORIGIN} https://api.mercadopago.com https://*.mercadopago.com https://*.mercadolibre.com https://*.mlstatic.com; frame-src ${CHECKOUT_KEYCLOAK_ORIGIN} https://*.mercadopago.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'" always;

    location = / {
        try_files /index.html =404;
    }

    location = /auth/callback {
        try_files /index.html =404;
    }

    location = /checkout/config.json {
        default_type application/json;
        return 200 '{"keycloakUrl":"${CHECKOUT_KEYCLOAK_ORIGIN}","yapeMinCentimos":${CHECKOUT_YAPE_MIN_CENTIMOS}}';
    }

    location /api/v1/ {
        set $gateway legal-gateway:18080;
        proxy_pass http://$gateway;
        proxy_set_header Host $http_host;
        proxy_read_timeout 40s;
    }

    location ~ ^/api/(casos|documentos|abogados|clientes|registros|solicitudes)(/|$) {
        set $gateway legal-gateway:18080;
        proxy_pass http://$gateway;
        proxy_set_header Host $http_host;
        proxy_read_timeout 40s;
    }

    location / {
        try_files $uri =404;
    }
}
